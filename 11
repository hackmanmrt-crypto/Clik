local START_DELAY = 25
local CLICK_DELAY = 0.5

local VirtualInputManager = game:GetService("VirtualInputManager")
local CoreGui = game:GetService("CoreGui")
local Camera = workspace.CurrentCamera
_G.AutoClicker = true

local function createCountdownUI()
    local screenGui = Instance.new("ScreenGui")
    screenGui.Name = "AutoClickerCount"
    screenGui.ResetOnSpawn = false
    
    if syn and syn.protect_gui then syn.protect_gui(screenGui) end
    screenGui.Parent = CoreGui

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(0, 200, 0, 100)
    textLabel.Position = UDim2.new(0.5, -100, 0.5, -50)
    textLabel.BackgroundTransparency = 1
    textLabel.Font = Enum.Font.RobotoMono
    textLabel.TextSize = 90
    textLabel.TextColor3 = Color3.fromRGB(0, 255, 255)
    textLabel.TextStrokeColor3 = Color3.fromRGB(0, 0, 0)
    textLabel.TextStrokeTransparency = 0
    textLabel.Parent = screenGui

    return screenGui, textLabel
end

task.spawn(function()
    local ui, label = createCountdownUI()

    for i = START_DELAY, 1, -1 do
        label.Text = tostring(i)
        if i <= 3 then
            label.TextColor3 = Color3.fromRGB(255, 0, 127)
        end
        task.wait(1)
    end

    ui:Destroy()

    while _G.AutoClicker do
        -- คำนวณหาจุดกึ่งกลางหน้าจอแบบ Real-time (เผื่อกรณีปรับขนาดหน้าต่างเกม)
        local screenSize = Camera.ViewportSize
        local CLICK_X = screenSize.X / 2
        local CLICK_Y = screenSize.Y / 2

        VirtualInputManager:SendMouseButtonEvent(CLICK_X, CLICK_Y, 0, true, game, 1)
        task.wait(0.02)
        VirtualInputManager:SendMouseButtonEvent(CLICK_X, CLICK_Y, 0, false, game, 1)
        task.wait(CLICK_DELAY)
    end
end)
